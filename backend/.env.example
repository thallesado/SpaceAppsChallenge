# Public NASA/JPL data used here does not require an API key.
# The downloaded LOLA IMG and matching LBL should share a directory.
LUNARPATH_DEM_PATH=data/ldem_75s_240m.img
LUNARPATH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional natural-language search; server-side only. Never use VITE_ for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
